SERVER_PORT=8081
DB_URL=jdbc:mysql://mysql:3306/farmatrade_auth_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=farmatrade_auth_user
DB_PASSWORD=replace-with-database-password

INITIAL_ADMIN_NAME=Initial Admin
INITIAL_ADMIN_EMAIL=admin@example.invalid
INITIAL_ADMIN_MOBILE=9000000000
INITIAL_ADMIN_PASSWORD=replace-with-strong-password
INITIAL_ADMIN_AADHAAR=900000000002

AUTH_RSA_PRIVATE_KEY_FILE=/run/secrets/farmatrade_auth_private_key.pem
AUTH_RSA_PRIVATE_KEY_PEM=
AUTH_RSA_PUBLIC_KEY_FILE=
AUTH_RSA_PUBLIC_KEY_PEM=
AUTH_JWT_KID=farmatrade-auth-rs256-1
AUTH_JWT_ISSUER=farmatrade-auth-service
AUTH_JWT_AUDIENCE=farmatrade-api
AUTH_JWT_ACCESS_TOKEN_MINUTES=15
AUTH_JWT_ALLOW_EPHEMERAL_KEY=false
AUTH_LOGIN_MAX_FAILED_ATTEMPTS=5
AUTH_LOGIN_LOCK_MINUTES=15
AUTH_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
